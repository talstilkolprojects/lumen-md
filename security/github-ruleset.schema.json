{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lumen-md.vercel.app/schemas/github-ruleset.schema.json",
  "$comment": "Plan W11.S4. The body of POST /repos/{owner}/{repo}/rulesets, from GitHub's REST reference (docs.github.com/en/rest/repos/rules, API version 2022-11-28; read 2026-11-15) and 'Available rules for rulesets'. Only the branch rule types are listed; any other type is refused, so a typo can't pass as an unknown rule.",
  "type": "object",
  "required": ["repo", "rulesets"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "rulesets": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ruleset" } }
  },
  "definitions": {
    "ruleset": {
      "type": "object",
      "required": ["name", "target", "enforcement", "bypass_actors", "conditions", "rules"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "enum": ["branch", "tag", "push"] },
        "enforcement": { "enum": ["disabled", "active", "evaluate"] },
        "bypass_actors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["actor_type", "bypass_mode"],
            "additionalProperties": false,
            "properties": {
              "actor_id": { "type": ["integer", "null"] },
              "actor_type": { "enum": ["Integration", "OrganizationAdmin", "RepositoryRole", "Team", "DeployKey", "User"] },
              "bypass_mode": { "enum": ["always", "pull_request", "exempt"] }
            }
          }
        },
        "conditions": {
          "type": "object",
          "required": ["ref_name"],
          "additionalProperties": false,
          "properties": {
            "ref_name": {
              "type": "object",
              "required": ["include", "exclude"],
              "additionalProperties": false,
              "properties": {
                "include": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(~DEFAULT_BRANCH|~ALL|refs/heads/.+)$" } },
                "exclude": { "type": "array", "items": { "type": "string", "pattern": "^refs/heads/.+$" } }
              }
            }
          }
        },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/rule" } }
      }
    },
    "rule": {
      "oneOf": [
        { "$ref": "#/definitions/bare" },
        { "$ref": "#/definitions/pullRequest" },
        { "$ref": "#/definitions/statusChecks" },
        { "$ref": "#/definitions/update" }
      ]
    },
    "bare": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "enum": ["creation", "deletion", "non_fast_forward", "required_signatures", "required_linear_history"] } }
    },
    "update": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "update" },
        "parameters": { "type": "object", "required": ["update_allows_fetch_and_merge"], "additionalProperties": false, "properties": { "update_allows_fetch_and_merge": { "type": "boolean" } } }
      }
    },
    "pullRequest": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "pull_request" },
        "parameters": {
          "type": "object",
          "required": ["required_approving_review_count", "dismiss_stale_reviews_on_push", "require_code_owner_review", "require_last_push_approval", "required_review_thread_resolution"],
          "additionalProperties": false,
          "properties": {
            "required_approving_review_count": { "type": "integer", "minimum": 0, "maximum": 10 },
            "dismiss_stale_reviews_on_push": { "type": "boolean" },
            "require_code_owner_review": { "type": "boolean" },
            "require_last_push_approval": { "type": "boolean" },
            "required_review_thread_resolution": { "type": "boolean" },
            "allowed_merge_methods": { "type": "array", "items": { "enum": ["merge", "squash", "rebase"] } }
          }
        }
      }
    },
    "statusChecks": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "required_status_checks" },
        "parameters": {
          "type": "object",
          "required": ["required_status_checks", "strict_required_status_checks_policy"],
          "additionalProperties": false,
          "properties": {
            "strict_required_status_checks_policy": { "type": "boolean" },
            "do_not_enforce_on_create": { "type": "boolean" },
            "required_status_checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["context"],
                "additionalProperties": false,
                "properties": { "context": { "type": "string", "minLength": 1 }, "integration_id": { "type": "integer" } }
              }
            }
          }
        }
      }
    }
  }
}
