# Cloudflare Pages security headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The policy values come from security/policy.json: edit that file and run
# `npm run headers:write` (CI runs `npm run headers` and fails on drift).

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://avatars.githubusercontent.com https://*.googleusercontent.com; media-src 'self' blob:; connect-src 'self' blob: data: wss://signaling.yjs.dev wss://y-webrtc-eu.fly.dev https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://api.mistral.ai http://localhost:11434 http://127.0.0.1:11434 http://localhost:8787 http://127.0.0.1:8787 http://localhost:8010 http://127.0.0.1:8010 http://localhost:9999 http://127.0.0.1:9999 http://localhost:5199 http://127.0.0.1:5199 https://api.languagetool.org https://kroki.io https://www.sefaria.org https://oauth2.googleapis.com https://www.googleapis.com https://api.dropboxapi.com https://content.dropboxapi.com https://github.com https://api.github.com https://huggingface.co https://*.huggingface.co https://*.hf.co https://raw.githubusercontent.com https://bsky.social https://plc.directory https://*.bsky.network https://webr.r-wasm.org https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types lumen default dompurify lit-html iconify ProseMirrorClipboard 'allow-duplicates'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), geolocation=(), microphone=(self), camera=()

# Web Playground runner: the page inside the playground block's sandboxed
# iframe (`sandbox="allow-scripts"`, opaque origin — it can't reach the app's
# storage or DOM). It runs the user's own project code, so it gets its own
# policy instead of the app's: blob: modules (the linked project files) and
# eval (Vue's template compiler), no Trusted Types, framing by the app only.
/playground-runner.html
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self' 'nonce-lumen-livejs-runner' blob: 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'

# live-js runner (T48): the hidden iframe live-js code runs in
# (`sandbox="allow-scripts"`, opaque origin: no IndexedDB, localStorage,
# OPFS, cookies or tokens of the app). The user's code runs in a blob: worker
# that inherits this policy: eval for the code itself, and no network at all.
/livejs-runner.html
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self' 'nonce-lumen-livejs-runner' blob: 'unsafe-eval'; worker-src blob:; connect-src 'none'; img-src 'none'; style-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'

# Content frame (plan W4.15): the same-origin page that shows, after the
# user allowed it, an image / video / audio from another site, a provider
# embed or a Gist (src/lib/contentFrame.ts). It carries https: in img-src and
# media-src and the embed providers in frame-src, so the app's policy does
# not. Framed by the app only.
/content-frame.html
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self' 'nonce-lumen-livejs-runner' https://gist.github.com; style-src 'self' 'unsafe-inline' https://github.githubassets.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.loom.com https://codepen.io https://codesandbox.io https://www.figma.com https://open.spotify.com https://www.google.com https://maps.google.com https://www.openstreetmap.org https://platform.twitter.com https://www.facebook.com https://www.instagram.com https://www.tiktok.com https://www.redditmedia.com https://www.reddit.com https://www.linkedin.com https://w.soundcloud.com; connect-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'

# On-device OCR (T31): the tesseract.js worker, its wasm cores and the language
# models (tesseract/lang/, same origin since plan 7.5). Dedicated workers get
# their own policy from their response; the app's Trusted Types requirement
# would block the worker's own importScripts() of the core.
/tesseract/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://raw.githubusercontent.com; worker-src 'self' blob:; base-uri 'none'; form-action 'none'

# Workers that need eval (F4 / P3): Graphviz (Emscripten embind builds its
# bindings with new Function), ruby.wasm and the TypeScript checker. A
# worker takes the CSP of its own script response, so eval is granted to
# these scripts only — the page itself allows none.
/assets/graphviz.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'
/assets/ruby.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'
/assets/tsCheck.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'
# webR's worker (/webr/webr-worker.js) is one of them: R.js evaluates the
# EM_ASM code of side modules and webr::eval_js() with eval.
/webr/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'

# The runner's opaque origin ("null") loads its own module chunks and Vue's
# ESM build with CORS: allow any origin to read these public, static,
# credential-free files.
/assets/*
  Access-Control-Allow-Origin: *
/playground/*
  Access-Control-Allow-Origin: *
