{
  "name": "lumen-md",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Lumen — a hybrid markdown editor focused on world-class rendering and turning data into beautiful tables and charts.",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs && node scripts/copy-ruby.mjs && node scripts/copy-ort.mjs && node scripts/copy-quickjs.mjs && node scripts/copy-vad.mjs && node scripts/copy-tesseract.mjs && node scripts/copy-excalidraw.mjs && node scripts/copy-playground-vendor.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/copy-ruby.mjs && node scripts/copy-ort.mjs && node scripts/copy-quickjs.mjs && node scripts/copy-vad.mjs && node scripts/copy-tesseract.mjs && node scripts/copy-excalidraw.mjs && node scripts/copy-playground-vendor.mjs",
    "build": "tsc -b && vite build",
    "webr:local": "node scripts/copy-webr.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "hygiene": "node scripts/check-code-hygiene.mjs && node scripts/audit-lock.mjs",
    "audit:lock": "node scripts/audit-lock.mjs",
    "secrets:scan-live": "node scripts/secrets-scan-live.mjs",
    "secrets:dist": "node scripts/secrets-scan-live.mjs --dir dist",
    "secrets:self-test": "node scripts/secrets-scan-live.mjs --self-test",
    "i18n:review": "node scripts/i18n-review.mjs",
    "licenses": "node scripts/licenses.mjs",
    "lexicon:build": "node scripts/build-hebrew-lexicon.mjs",
    "golden": "node scripts/golden.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icons": "tauri icon public/favicon.svg",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:run": "npm run ios:sync && npx cap run ios",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "test": "vitest run",
    "lumen": "tsx bin/lumen.ts",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "node scripts/mutation/run.mjs --min 70",
    "test:watch": "vitest",
    "test:crash": "node scripts/vault-crash-test.mjs --kills 1000",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:gate": "node scripts/e2e-gate.mjs",
    "e2e:flake": "node scripts/e2e-flake.mjs",
    "perf:inp": "playwright test --project=inp && node scripts/perf/inp-gate.mjs",
    "perf:inp:gate": "node scripts/perf/inp-gate.mjs",
    "preview:visual": "node scripts/preview-visual.mjs",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "budget": "node scripts/bundle-budget.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "perf:vault100k": "node --expose-gc --max-old-space-size=4096 --import tsx scripts/perf/vault-100k.ts",
    "lighthouse": "lhci autorun --config=./lighthouserc.json",
    "perf:gate": "node scripts/perf-gate.mjs",
    "lighthouse:a11y": "node scripts/lighthouse-a11y.mjs",
    "i18n:extract": "node scripts/extract-i18n-keys.mjs",
    "i18n:check": "node scripts/i18n-split.mjs --check && node scripts/extract-i18n-keys.mjs --check && node scripts/check-i18n-hardcoded.mjs",
    "i18n:hardcoded": "node scripts/check-i18n-hardcoded.mjs",
    "messages:check": "node scripts/check-raw-errors.mjs && node scripts/check-empty-states.mjs && node scripts/check-destructive.mjs",
    "i18n:fix": "node scripts/i18n-split.mjs && node scripts/extract-i18n-keys.mjs > /dev/null",
    "i18n:split": "node scripts/i18n-split.mjs",
    "i18n:draft": "node scripts/i18n-draft.mjs",
    "docker:build": "docker build -t lumen-md .",
    "docker:run": "docker run -p 8080:8080 lumen-md",
    "eval:agents": "node scripts/agent-eval.mjs",
    "eval:tool-calls": "node scripts/tool-call-eval.mjs",
    "eval:compare": "node scripts/eval-compare.mjs",
    "fake-ollama": "node --experimental-strip-types scripts/fake-ollama.mjs",
    "headers": "node scripts/headers.mjs --check",
    "headers:write": "node scripts/headers.mjs --write",
    "handoff": "node scripts/handoff.mjs",
    "docs:sync": "node scripts/docs-sync.mjs",
    "collab:deploy": "node scripts/collab-deploy.mjs",
    "lint": "eslint src",
    "lint:prune": "eslint src --prune-suppressions",
    "plan": "node scripts/plan/build.mjs",
    "plan:check": "node scripts/plan/build.mjs --check",
    "models:registry": "node scripts/models/registry-from-run.mjs",
    "dod": "node scripts/dod.mjs",
    "unused": "node scripts/check-unused-files.mjs",
    "ci:real-model": "node scripts/real-tiny-model.mjs",
    "docs:complete": "node scripts/docs-complete.mjs",
    "bench:fim": "node --experimental-strip-types scripts/bench-fim.mjs",
    "models:day": "node scripts/models-day.mjs",
    "eval:asr-web": "node scripts/asr/web-eval.mjs",
    "eval:voice-commands": "node --experimental-strip-types scripts/voice-commands-eval.mjs",
    "eval:pdf-chat": "LUMEN_EVAL_PDF=1 vitest run --config vitest.eval.config.ts src/agents/eval/pdfChat.eval.ts",
    "eval:summarize": "LUMEN_EVAL_SUMMARY=1 vitest run --config vitest.eval.config.ts src/agents/eval/summarize.eval.ts",
    "eval:rerank": "LUMEN_EVAL_RERANK=1 vitest run --config vitest.eval.config.ts src/agents/eval/rerank.eval.ts",
    "eval:meetings": "LUMEN_EVAL_MEETINGS=1 vitest run --config vitest.eval.config.ts src/agents/eval/meetings.eval.ts",
    "release": "node scripts/release.mjs",
    "fuzz": "node scripts/fuzz/run.mjs --runs 1000000",
    "sbom": "node scripts/supply-chain/sbom.mjs",
    "release:sign": "node scripts/supply-chain/release.mjs",
    "release:verify": "node scripts/supply-chain/verify-release.mjs",
    "repro": "node scripts/supply-chain/repro-check.mjs",
    "check:test-surface": "node scripts/check-test-surface.mjs",
    "bench:sync": "tsx scripts/bench/sync-first.ts",
    "dictalm3": "node scripts/dictalm3.mjs",
    "whisper:desktop": "node scripts/whisper-desktop.mjs",
    "docs:search": "node scripts/docs-search.mjs",
    "perf:coldstart": "playwright test --project=coldstart --project=coldstart-phone",
    "design:check": "node scripts/check-design.mjs && node scripts/design-audit.mjs",
    "eval:canvas-draw": "node scripts/canvas-draw-eval.mjs",
    "acr": "node scripts/acr.mjs",
    "acr:check": "node scripts/acr.mjs --check",
    "md:conformance": "vitest run src/__tests__/mdConformance.test.ts src/__tests__/mdRoundTrip.test.ts src/__tests__/sourcePreserve.test.ts",
    "help:bundle": "node scripts/help-bundle.mjs",
    "help:check": "node scripts/help-bundle.mjs --check",
    "flags:check": "node scripts/check-flags.mjs",
    "bench:models": "node scripts/bench-models.mjs",
    "pr:check": "node scripts/pr-check.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "store:check": "node scripts/store.mjs check",
    "eval:crosslingual": "LUMEN_EVAL_XL=1 vitest run --config vitest.eval.config.ts src/agents/eval/crosslingual.eval.ts",
    "eval:lit-review": "LUMEN_EVAL_LIT=1 vitest run --config vitest.eval.config.ts src/agents/eval/litReview.eval.ts",
    "skips": "node scripts/skip-report.mjs",
    "nightly": "node scripts/nightly/run.mjs",
    "tts:mos": "node scripts/tts-mos.mjs",
    "test:sr": "playwright test -c sr/playwright.sr.config.ts",
    "drill:data-safety": "node scripts/data-safety-drill.mjs",
    "mutation:check": "node scripts/mutation/check.mjs"
  },
